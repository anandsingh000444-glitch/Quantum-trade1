{
  "version": 2,
  "builds": [
    { "src": "api/chat.js",    "use": "@vercel/node" },
    { "src": "api/news.js",    "use": "@vercel/node" },
    { "src": "api/market.js",  "use": "@vercel/node" },
    { "src": "api/options.js", "use": "@vercel/node" },
    { "src": "index.html",     "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/chat",    "dest": "/api/chat.js"    },
    { "src": "/api/news",    "dest": "/api/news.js"    },
    { "src": "/api/market",  "dest": "/api/market.js"  },
    { "src": "/api/options", "dest": "/api/options.js" },
    { "src": "/(.*)",        "dest": "/index.html"     }
  ]
}